events {
    worker_connections 1024;
}

http {
    server {
        listen 80;

        {% for service in services %}
        location = /{{ service.name }} {
            return 301 $scheme://$http_host/{{ service.name }}/;
        }
        location /{{ service.name }}/ {
            proxy_pass http://{{ service.name }}:5000;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Переписываем Location от Flask: http://service:5000/... → http://localhost:8888/...
            proxy_redirect http://{{ service.name }}:5000/ $scheme://$http_host/;
            proxy_connect_timeout 60s;
            proxy_read_timeout 60s;
        }
        {% endfor %}

        {% if services %}
        location / {
            return 302 $scheme://$http_host/{{ services[0].name }}/;
        }
        {% endif %}
    }
}
